[Unit]
Description=Major Tom read-only Hercules audit
After=hercules-dashboard.service network-online.target

[Service]
Type=oneshot
User=galgo
WorkingDirectory=/home/galgo/Documentos/Hercules-3.0-Rebuilt
StateDirectory=major-tom
Environment=MAJOR_TOM_AUDIT_FILE=/var/lib/major-tom/last-audit.json
Environment=MAJOR_TOM_TRACE_DB=/var/lib/major-tom/traces.sqlite3
ExecStart=/usr/bin/python3 -m major_tom.cli audit
